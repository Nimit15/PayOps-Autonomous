# PayPal Sandbox Credentials
# Get from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_webhook_id_from_dashboard

# PayPal API Base URL (sandbox)
PAYPAL_SANDBOX_BASE_URL=https://api-m.sandbox.paypal.com

# Channel3 API Key
# Get from: https://trychannel3.com
CHANNEL3_API_KEY=your_channel3_api_key
CHANNEL3_DEFAULT_COUNTRY=US
CHANNEL3_DEFAULT_CURRENCY=USD
CHANNEL3_DEFAULT_LANGUAGE=en

# App URL (for webhook callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Render deployment
# RENDER_API_KEY=your_render_api_key